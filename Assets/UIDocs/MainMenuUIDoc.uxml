<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/StyleSheets/UIStyleSheet.uss?fileID=7433441132597879392&amp;guid=05bc233838cd25b4d91a12cf5ea469a4&amp;type=3#UIStyleSheet"/>
    <ui:VisualElement style="flex-grow: 1; justify-content: center; align-items: center; background-image: url(&quot;project://database/Assets/Sprites/Environment/Backgrounds/MainMenuBackgroundImage.png?fileID=2800000&amp;guid=7274f79e3412f4a45b173df6a9c729b8&amp;type=3#MainMenuBackgroundImage&quot;); -unity-background-scale-mode: stretch-to-fill; background-position-x: center; background-position-y: center; -unity-background-image-tint-color: rgb(199, 234, 219); background-color: rgb(46, 47, 51); background-repeat: no-repeat no-repeat; display: flex;">
        <ui:Label text="SCIENTOLOGY SPEED RUN: &#10;THE GAME" double-click-selects-word="false" style="-unity-text-align: middle-center; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(255, 255, 255); word-spacing: 0; letter-spacing: 5px; -unity-paragraph-spacing: 14px; top: auto; position: relative; width: auto; font-size: 30px; color: rgb(0, 0, 0);"/>
        <ui:Button text="Start Game" name="PlayButton" class="buttonGreen"/>
        <ui:Button text="Quit Game" name="QuitButton" class="buttonRed"/>
        <ui:Button text="Controls" name="ControlsButton" class="buttonYellow"/>
        <ui:Label text="by: abe" selectable="true" focusable="true" style="color: rgb(0, 0, 0); -unity-text-align: middle-center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="ControlsScreen" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgb(64, 64, 64); align-items: center; justify-content: center; display: none;">
        <ui:Label text="CONTROLS" style="font-size: 40px;"/>
        <ui:VisualElement name="BindingsContainer" style="flex-grow: 1;">
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="W/SPACE" style="flex-shrink: 0;"/>
                <ui:Label text="JUMP"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="L SHIFT" style="flex-shrink: 0;"/>
                <ui:Label text="HOLD TO &#10;SPRINT"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="A"/>
                <ui:Label text="MOVE LEFT"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="S"/>
                <ui:Label text="CROUCH"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="D"/>
                <ui:Label text="MOVE RIGHT"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="J"/>
                <ui:Label text="LIGHT ATTACK"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="K"/>
                <ui:Label text="HEAVY ATTACK"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-wrap: nowrap;">
                <ui:Label text="HOLD SHIFT &#10;WHILE ATTACKING TO &#10;PERFORM COMBO" style="white-space: nowrap;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlRow" style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="1, 2,3"/>
                <ui:Label text="SWITCH WEAPONS"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="BACK" name="ControlsBackButton" class="buttonRed"/>
    </ui:VisualElement>
</ui:UXML>
