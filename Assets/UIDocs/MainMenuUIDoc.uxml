    <ui:VisualElement style="flex-grow: 1; justify-content: center; align-items: center; background-image: url(&quot;project://database/Assets/Sprites/Environment/Backgrounds/MainMenuBackgroundImage.png?fileID=2800000&amp;guid=7274f79e3412f4a45b173df6a9c729b8&amp;type=3#MainMenuBackgroundImage&quot;); -unity-background-scale-mode: scale-and-crop; background-position-x: right -45px; background-position-y: top 0; -unity-background-image-tint-color: rgb(199, 234, 219); background-color: rgb(46, 47, 51); background-repeat: no-repeat no-repeat;">
